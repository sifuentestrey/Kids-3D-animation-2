GEMINI_API_KEY=

# Optional: enables turning a kid's drawing into a real 3D mesh in the 3D
# scene. Get these from your Higgsfield account's API keys page (this is
# separate from any Claude/MCP connection to Higgsfield). Leaving these
# unset just means creatures stay as flat 2.5D cutouts - the app never
# fails visibly either way.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
